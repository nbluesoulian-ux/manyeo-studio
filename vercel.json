{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/projects",
      "destination": "/work/index.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/projects/detail"
    }
  ]
}
